# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite for local dev; use Postgres in staging/production:
# DATABASE_URL=postgres://hotel:password@localhost:5432/hotel
# Leave unset to use the local db.sqlite3

DEFAULT_FROM_EMAIL=noreply@yourhotel.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
TIME_ZONE=Africa/Lagos

# Production only (DJANGO_DEBUG=False)
# DJANGO_ADMIN_URL=some-unguessable-path/
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourhotel.com

# Auth
FRONTEND_URL=http://localhost:3000
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_HOURS=12
# Set to 1 when running behind nginx / a load balancer
# NUM_PROXIES=0

# Hotel policies
# HOTEL_CHECK_IN_TIME=14:00
# HOTEL_CHECK_OUT_TIME=12:00
# BOOKING_HOLD_MINUTES=15
# FREE_CANCELLATION_HOURS=48
# CANCELLATION_PENALTY_NIGHTS=1

# Encryption key(s) for guest ID numbers - REQUIRED in production. Back it up:
# encrypted data is unrecoverable without it. Rotate by prepending a new key.
# FIELD_ENCRYPTION_KEYS=
# REQUIRE_GUEST_ID_AT_CHECK_IN=True

# Hotel identity (printed on invoices)
# HOTEL_NAME=Grand Hotel
# HOTEL_ADDRESS=1 Ahmadu Bello Way, Victoria Island, Lagos
# HOTEL_PHONE=+234 ...
# HOTEL_EMAIL=reservations@yourhotel.com
# HOTEL_TAX_ID=
# HOTEL_CURRENCY=NGN
# INVOICE_PREFIX=INV
# CHECKOUT_REQUIRES_SETTLED_FOLIO=True

# Payments (test keys outside production)
# PAYMENT_GATEWAYS=PAYSTACK,FLUTTERWAVE
# PAYSTACK_SECRET_KEY=sk_test_...
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# FLUTTERWAVE_WEBHOOK_HASH=<the secret hash set in the Flutterwave dashboard>
# PAYMENT_CALLBACK_URL=https://yourhotel.com/booking/payment-complete

# Background jobs: run `python manage.py run_worker` alongside the web server
# TASK_BACKEND=database
# Guest SMS / WhatsApp (Termii)
# SMS_ENABLED=True
# WHATSAPP_ENABLED=False
# TERMII_API_KEY=
# TERMII_SENDER_ID=YourHotel

# Channel manager (Channex). Connection, API key and mappings are set in the admin.
# CHANNEX_BASE_URL=https://app.channex.io/api/v1
# Door locks
# LOCK_SYSTEM=none            # or: bridge
# LOCK_BRIDGE_URL=http://lock-server.local:8090
# LOCK_BRIDGE_SECRET=

# Scaling (see docs/DEPLOYMENT.md, "Scaling for traffic")
# Shared cache for rate limits, sign-in sessions and cached public pages. Required with several
# server processes (docker-compose sets it to its Redis); default: in-memory, fine for one process.
# CACHE_URL=redis://redis:6379/0
# PUBLIC_CACHE_SECONDS=300
# PostgreSQL connection pool per server process
# DB_POOL=True
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10
# DB_CONN_MAX_AGE=60          # used when DB_POOL=False (e.g. behind PgBouncer)
# Gunicorn (deploy/gunicorn.conf.py)
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=60
